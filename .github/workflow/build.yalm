name: Construir APK de El Impostor desde ZIP

on:
  push:
    branches: [ "main", "master" ]
    paths:
      - '**/*.zip'
      - '.github/workflows/**'
  pull_request:
    branches: [ "main", "master" ]
  workflow_dispatch: # Permite ejecutar manualmente desde la pestaña Actions en GitHub

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: 📥 Clonar el Repositorio
        uses: actions/checkout@v4
        with:
          fetch-depth: 0 # Obtiene todo el historial para detectar la fecha de los commits

      - name: 🔍 Buscar el archivo .zip añadido más recientemente
        id: find_zip
        run: |
          echo "=============================================="
          echo " Buscando archivos .zip en el repositorio..."
          echo "=============================================="
          
          # Buscar todos los archivos .zip en el repositorio
          ZIP_FILES=$(find . -maxdepth 3 -name "*.zip" -type f)
          
          if [ -z "$ZIP_FILES" ]; then
            echo "⚠️ No se encontró ningún archivo .zip. Se usará el código fuente en la raíz."
            echo "USE_ZIP=false" >> $GITHUB_ENV
          else
            echo "Archivos .zip encontrados en el repositorio:"
            echo "$ZIP_FILES"
            
            # Ordenar por fecha de modificación / commit y seleccionar el más reciente
            LATEST_ZIP=$(ls -t $ZIP_FILES | head -n 1)
            echo "----------------------------------------------"
            echo "✅ Archivo .zip MÁS RECIENTE seleccionado: $LATEST_ZIP"
            echo "----------------------------------------------"
            echo "LATEST_ZIP=$LATEST_ZIP" >> $GITHUB_ENV
            echo "USE_ZIP=true" >> $GITHUB_ENV
          fi

      - name: 📦 Extraer el archivo .zip seleccionado
        if: env.USE_ZIP == 'true'
        run: |
          mkdir -p workspace_app
          unzip -o "$LATEST_ZIP" -d workspace_app
          echo "Contenido extraído correctamente en workspace_app:"
          ls -la workspace_app

      - name: ⚙️ Configurar Directorio de Trabajo
        run: |
          if [ "$USE_ZIP" = "true" ]; then
            # Si el archivo zip contenía una subcarpeta interna, reubicar
            if [ ! -f "workspace_app/package.json" ]; then
              SUBDIR=$(find workspace_app -maxdepth 2 -name "package.json" -exec dirname {} \;)
              if [ -n "$SUBDIR" ]; then
                echo "Moviendo archivos desde $SUBDIR a workspace_app"
                cp -r $SUBDIR/* workspace_app/ || true
              fi
            fi
            echo "APP_DIR=workspace_app" >> $GITHUB_ENV
          else
            echo "APP_DIR=." >> $GITHUB_ENV
          fi

      - name: 🟢 Configurar Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20
          cache-dependency-path: ${{ env.APP_DIR }}/package.json

      - name: ☕ Configurar Java JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: 📱 Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: 📥 Instalar Dependencias de la App
        working-directory: ${{ env.APP_DIR }}
        run: |
          npm install --legacy-peer-deps
          npm install @capacitor/core @capacitor/cli @capacitor/android --save

      - name: 🏗️ Compilar Proyecto Web (Vite)
        working-directory: ${{ env.APP_DIR }}
        run: npm run build

      - name: 🤖 Inicializar y Sincronizar Capacitor Android
        working-directory: ${{ env.APP_DIR }}
        run: |
          if [ ! -f "capacitor.config.json" ]; then
            cat << 'EOF' > capacitor.config.json
          {
            "appId": "com.kendry.elimpostor",
            "appName": "El Impostor",
            "webDir": "dist",
            "server": {
              "androidScheme": "https"
            }
          }
          EOF
          fi
          
          if [ ! -d "android" ]; then
            npx cap add android
          fi
          
          npx cap sync android

      - name: 🛠️ Compilar el archivo APK con Gradle
        working-directory: ${{ env.APP_DIR }}/android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug --stacktrace

      - name: 📤 Subir APK Generado como Artefacto
        uses: actions/upload-artifact@v4
        with:
          name: El-Impostor-APK-Debug
          path: ${{ env.APP_DIR }}/android/app/build/outputs/apk/debug/*.apk
          retention-days: 30
